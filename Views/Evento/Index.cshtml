@using ImOdNotes.Models.ViewModels;
@model PaginadoViewModel<ImOdNotes.Core.Entities.Evento>

@* @model IEnumerable<ImOdNotes.Core.Entities.Evento> *@

@{
	ViewData["Title"] = "Index";
}
@section MenuPagina {
	@{
		await Html.RenderPartialAsync("_MenuAsideHome");
	}
}

<div id="pagina">
	<div id="principal">
		<div class="opcionesHeader">

			<div class="tituloOpciones">
				<h2>
					<i class="bi bi-calendar-event"></i>
					Eventos
				</h2>
			</div>
			<partial name="_MenuAsideEventos" />

		</div>
		<div id="tablaIndex">
			<table class="table">
				<thead>
					<tr>
						<th>
							@Html.DisplayNameFor(model => model.Lista.First().Titulo)
						</th>
						<th>
							@Html.DisplayNameFor(model => model.Lista.First().Descripcion)
						</th>
						<th>
							@Html.DisplayNameFor(model => model.Lista.First().FechaInicio)
						</th>
						<th>
							@* @Html.DisplayNameFor(model => model.Lista.First().CategoriaEvento) *@ Categoría
						</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model.Lista)
					{
						<tr>
							<td>
								@Html.DisplayFor(modelItem => item.Titulo)
							</td>
							<td>
								@Html.DisplayFor(modelItem => item.Descripcion)
							</td>
							<td>
								@item.FechaInicio.ToString("dd/MM/yyyy")
							</td>
							<td>
								@Html.DisplayFor(modelItem => item.CategoriaEvento.Nombre)
							</td>
							<td>
								<a asp-action="Details"
									   asp-route-id="@item.Id"
									   type="button"
									   class="btn btn-outline-primary btn-sm">
									<i class="bi-journal-text"></i>
								</a>
								<a asp-action="Edit"
									   asp-route-id="@item.Id"
									   type="button"
									   class="btn btn-outline-primary btn-sm">
									<i class="bi-pencil"></i>
								</a>
								<a asp-action="Favorito"
									   asp-route-id="@item.Id"
									   asp-route-page="@ViewBag.PaginaActual"
									   type="button" class="btn btn-outline-primary btn-sm">
									<i class="bi @((item.Favorito) ? "bi bi-star-fill text-primary" : "bi-star text-muted")"></i>
								</a>
								<a asp-action="Delete"
									   asp-route-id="@item.Id"
									   type="button"
									   class="btn btn-outline-secondary btn-sm">
									<i class="bi-trash text-danger"></i>
								</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
			<hr />
			@* P    A   G   I   N   A   C   I   O   N *@
			<div class="paginacion">
				<partial name="_Paginacion" model="Model" />
			</div>
		</div>
	</div>
</div>