@using ImOdNotes.Core.Enums
@model ImOdNotes.Core.Entities.Gasto

@{
	ViewData["Title"] = "Edit";
}
@section MenuPagina {
	@{
		await Html.RenderPartialAsync("_MenuAsideHome");
	}
}

<div id="pagina">
	<div id="principal">
		<div class="opcionesHeader">

			<div class="tituloOpciones">
				<h2>
					<i class="bi bi-calendar-event"></i>
					Editar Gastos
				</h2>
			</div>
			<partial name="_MenuAsideGastos" />

		</div>
		<h3>Editar gasto</h3>
		<hr />
		<div class="row">
			<div class="col-md-12">
				<form asp-action="Edit">
					<div asp-validation-summary="ModelOnly" class="text-danger"></div>
					<input type="hidden" asp-for="Id" />
					<div class="form-group">
						<label asp-for="Titulo" class="control-label"></label>
						<input asp-for="Titulo" class="form-control" />
						<span asp-validation-for="Titulo" class="text-danger"></span>
					</div>
					<div class="row">
						<div class="col-md-6">
							<div class="form-group">
								<label asp-for="Monto" class="control-label"></label>
								<input asp-for="Monto" class="form-control" />
								<span asp-validation-for="Monto" class="text-danger"></span>
							</div>
						</div>
						
						<div class="form-group col-md-6">
							<label class="control-label">Tipo</label>

							<div class="d-flex gap-2 flex-wrap">
								@foreach (var item in Html.GetEnumSelectList<TipoGasto>())
								{
									<input type="radio"
										   class="btn-check"
										   name="Tipo"
										   id="tipo_@item.Value"
										   value="@item.Text"
										   autocomplete="off"
									@(Model.Tipo == item.Text ? "checked" : "") />

									<label class="spring-chip @(item.Text == "Ingreso" ? "tipo-ingreso" : "tipo-gasto")"
										   for="tipo_@item.Value">

										@if (item.Text == "Ingreso")
										{
											<i class="bi bi-arrow-down-circle"></i>
										}
										else
										{
											<i class="bi bi-arrow-up-circle"></i>
										}

										@item.Text
									</label>
								}
							</div>

							<span asp-validation-for="Tipo" class="text-danger"></span>
						</div>
						<div class="row">
							<div class="col-md-6">
								<div class="form-group">
									<label asp-for="CategoriaId" class="control-label"></label>
									<select asp-for="CategoriaId" class="form-control" asp-items="ViewBag.CategoriaId"></select>
									<span asp-validation-for="CategoriaId" class="text-danger"></span>
								</div>
							</div>
							<div class="col-md-6">
								<div class="form-group">
									<label asp-for="Favorito" class="control-label"></label>
									<input asp-for="Favorito" class="form-control" />
									<span asp-validation-for="Favorito" class="text-danger"></span>
								</div>
							</div>
						</div>
						<div class="form-group">
							<div id="finalFormulario">
								<a asp-action="Index">Regresar a la Lista</a>
								<input type="submit" value="Guardar" class="btn btn-primary" />
							</div>
						</div>
					</form>
				</div>
			</div>

		</div>
	</div>
	@section Scripts {
		@{
			await Html.RenderPartialAsync("_ValidationScriptsPartial");
		}
	}