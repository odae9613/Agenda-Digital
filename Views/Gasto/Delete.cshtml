@model ImOdNotes.Core.Entities.Gasto

@{
	ViewData["Title"] = "Delete";
}
@section MenuPagina {
	@{
		await Html.RenderPartialAsync("_MenuAsideHome");
	}
}

<div id="pagina">
	<div id="principal">
		<div class="opcionesHeader">

			<div class="tituloOpciones">
				<h2>
					<i class="bi bi-calendar-event"></i>
					Eliminar Gastos
				</h2>
			</div>
			<partial name="_MenuAsideGastos" />

		</div>
		<h3>Eliminar gasto: @Html.DisplayFor(model => model.Titulo)</h3>
		<h6>¿Estás seguro de eliminar este gasto?</h6>
		<div>
			<hr />
			<dl class="row">
				<dt class="col-sm-3">
					@Html.DisplayNameFor(model => model.Titulo)
				</dt>
				<dd class="col-sm-9">
					@Html.DisplayFor(model => model.Titulo)
				</dd>
				<dt class="col-sm-3">
					@Html.DisplayNameFor(model => model.Monto)
				</dt>
				<dd class="col-sm-9">
					@Html.DisplayFor(model => model.Monto)
				</dd>
				<dt class="col-sm-3">
					@Html.DisplayNameFor(model => model.FechaCreacion)
				</dt>
				<dd class="col-sm-9">
					@Html.DisplayFor(model => model.FechaCreacion)
				</dd>
				<dt class="col-sm-3">
					@Html.DisplayNameFor(model => model.CategoriaGasto)
				</dt>
				<dd class="col-sm-9">
					@Html.DisplayFor(model => model.CategoriaGasto.Nombre)
				</dd>
				<dt class="col-sm-3">
					@Html.DisplayNameFor(model => model.Tipo)
				</dt>
				<dd class="col-sm-9">
					<partial name="_TipoGasto" model="Model.Tipo" />
				</dd>
			</dl>
			<form asp-action="Delete">
				<input type="hidden" asp-for="Id" />
				<div id="finalFormulario">
					<a asp-action="Index">Regresar a la Lista</a>
					<input type="submit" value="Eliminar" class="btn btn-danger" />
				</div>
			</form>
		</div>
	</div>
</div>