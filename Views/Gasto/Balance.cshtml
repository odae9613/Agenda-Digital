@{
	ViewData["Title"] = "Balance";
}
@section MenuPagina {
	@{
		await Html.RenderPartialAsync("_MenuAsideGastos");
	}
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<div id="pagina">
	<div id="paginaFinanzas">
		<div class="cabeceraFinanzas">
			<div class="leftFinanzas">
				<span>Finanzas</span>
				<p>@ViewBag.mes.ToString("MMMM")</p>
				<i class="bi bi-bar-chart"></i>
			</div>
			<div class="rightFinanzas">
				<a asp-area="" asp-controller="Gasto" asp-action="create">+ Añadir Transacción</a>
			</div>
		</div>
		<div class="balanceContainer">

			<div class="card ingreso">
				<i class="bi-graph-up-arrow"></i>
				<h4>Ingresos</h4>
				<h2>@ViewBag.Ingresos €</h2>
			</div>

			<div class="card gasto">
				<i class="bi-graph-down-arrow"></i>
				<h4>Gastos</h4>
				<h2>@ViewBag.Gastos €</h2>
			</div>

			<div class="card total">
				<i class="bi bi-calculator"></i>
				<h4>Balance</h4>
				<h2>@ViewBag.Balance €</h2>
			</div>

		</div>
	</div>
</div>