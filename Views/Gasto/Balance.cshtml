@{
	ViewData["Title"] = "Balance";
}
@section MenuPagina {
	@{
		await Html.RenderPartialAsync("_MenuAsideHome");
	}
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<div id="pagina">
	<div class="opcionesHeader">

		<div class="tituloOpciones">
			<h2>
				<i class="bi bi-calendar-event"></i>
				Balance
			</h2>
		</div>
		<partial name="_MenuAsideGastos" />

	</div>
	<div id="paginaFinanzas">
		<div class="cabeceraFinanzas">
			<i>Finanzas</i>
			<i class="bi bi-bar-chart"></i>
			<i>@ViewBag.mes.ToString("MMMM")</i>
		</div>
		<div class="balanceContainer">

			<div class="financeCard ingreso">
				<i class="bi-graph-up-arrow"></i>
				<h4>Ingresos</h4>
				<h2>@ViewBag.Ingresos €</h2>
			</div>

			<div class="financeCard gasto">
				<i class="bi-graph-down-arrow"></i>
				<h4>Gastos</h4>
				<h2>@ViewBag.Gastos €</h2>
			</div>

			<div class="financeCard total">
				<i class="bi bi-calculator"></i>
				<h4>Balance</h4>
				<h2>@ViewBag.Balance €</h2>
			</div>

		</div>
	</div>
</div>