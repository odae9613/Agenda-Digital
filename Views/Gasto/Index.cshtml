@using ImOdNotes.Models.ViewModels;
@model PaginadoViewModel<ImOdNotes.Core.Entities.Gasto>

@section MenuPagina {
    @{
        await Html.RenderPartialAsync("_MenuAsideHome");
    }
}
<div id="pagina">
    <div class="opcionesHeader">

        <div class="tituloOpciones">
            <h2>
                <i class="bi bi-calendar-event"></i>
                Gastos
            </h2>
        </div>
        <partial name="_MenuAsideGastos" />

    </div>
    <div id="tablaIndex">
        <table class="table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Lista.First().Titulo)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Lista.First().Monto)
                    </th>
                    <th>
                        Categoria
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Lista.First().Tipo)
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Lista)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Titulo)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Monto)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CategoriaGasto.Nombre)
                        </td>
                        <td>
                            <td>
                                @if (item.Tipo == "Ingreso")
                                {
                                    <div class="tipo-spring tipo-ingreso">
                                        <i class="bi bi-arrow-down-circle"></i>
                                        <span>Ingreso</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="tipo-spring tipo-gasto">
                                        <i class="bi bi-arrow-up-circle"></i>
                                        <span>Gasto</span>
                                    </div>
                                }
                            </td>
                        <td>
                            <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   type="button"
                                   class="btn btn-outline-primary btn-sm">
                                <i class="bi-journal-text"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id"
                                   type="button"
                                   class="btn btn-outline-primary btn-sm">
                                <i class="bi-pencil"></i>
                            </a>
                            <a asp-action="Favorito"
                                   asp-route-id="@item.Id"
                                   asp-route-page="@ViewBag.PaginaActual"
                                   type="button" class="btn btn-outline-primary btn-sm">
                                <i class="bi @((item.Favorito) ? "bi bi-star-fill text-primary" : "bi-star text-muted")"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id"
                                   type="button"
                                   class="btn btn-outline-secondary btn-sm">
                                <i class="bi-trash text-danger"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <hr />
        @* P    A   G   I   N   A   C   I   O   N *@
       <div>
           <partial name="_Paginacion" model="Model" />
       </div>
    </div>
</div>
