@using ImOdNotes.Models.ViewModels;
@model PaginadoViewModel<ImOdNotes.Core.Entities.Gasto>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

@section MenuPagina {
	@{
		await Html.RenderPartialAsync("_MenuAsideHome");
	}
}
<div id="pagina">
	<div class="opcionesHeader">

		<div class="tituloOpciones">
			<h2>
				<i class="bi bi-calendar-event"></i>
				Gastos favoritos
			</h2>
		</div>
		<partial name="_MenuAsideGastos" />

	</div>
	<div id="tablaIndex">
    
		<table class="table">
			<thead>
				<tr>
					<th>
						Título
					</th>
					<th>
						Monto
					</th>
					<th>
						Notas
					</th>
					<th>
						Tipo
					</th>
					<th>
						Categoría
					</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var item in Model.Lista)
				{
					<tr>
						<td>
							@Html.DisplayFor(modelItem => item.Titulo)
						</td>
						<td>
							@Html.DisplayFor(modelItem => item.Monto)
						</td>
						<td>
							@Html.DisplayFor(modelItem => item.Notas)
						</td>
						<td>
							@Html.DisplayFor(modelItem => item.Tipo)
						</td>
						<td>
							@Html.DisplayFor(modelItem => item.CategoriaGasto.Nombre)
						</td>
					</tr>
				}
			</tbody>
		</table>
		
		@* P    A   G   I   N   A   C   I   O   N *@
		<div class="paginacion">
			<partial name="_Paginacion" model="Model" />
		</div>
	</div>
</div>
