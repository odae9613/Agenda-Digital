@using ImOdNotes.Models.ViewModels
@model PaginadoViewModel<ImOdNotes.Core.Entities.Nota>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

@section MenuPagina {
	@{
		await Html.RenderPartialAsync("_MenuAsideHome");
	}
}
<div id="pagina">
	<div class="opcionesHeader">

		<div class="tituloOpciones">
			<h2>
				<i class="bi bi-stickies"></i>
				Notas favoritas
			</h2>
		</div>
		<partial name="_MenuAsideNotas" />

	</div>
	<div class="notas">
		@foreach(var item in Model.Lista)
		{
			<div class="cardNotas">
				<a asp-area="" asp-controller="Nota" asp-action="Details"
					   asp-route-id="@item.Id"
					   type="button">
					<span class="tituloCard">
						<h5 class="tituloNota">
							@Html.DisplayFor(modelItem => item.Titulo)
						</h5>
						<i class="bi bi-journal-richtext"></i>
					</span>
				</a>
				<hr />
				<p>
					@Html.DisplayFor(modelItem => item.Contenido)
				</p>
				<hr />
				<div class="acciones">
					<a asp-action="Details" asp-route-id="@item.Id"
						   type="button"
						   class="btn btn-outline-primary btn-sm">
						<i class="bi-journal-text"></i>
					</a>
					<a asp-action="Edit" asp-route-id="@item.Id"
						   type="button"
						   class="btn btn-outline-primary btn-sm">
						<i class="bi-pencil"></i>
					</a>
					<a asp-action="Favorito"
						   asp-route-id="@item.Id"
						   type="button" class="btn btn-outline-primary btn-sm">
						<i class="bi @((item.Favorito) ? "bi bi-star-fill" : "bi-star")"></i>
					</a>
					<a asp-action="Delete"
						   asp-route-id="@item.Id"
						   type="button"
						   class="btn btn-outline-secondary btn-sm">
						<i class="bi-trash"></i>
					</a>
				</div>
			</div>
		}
	</div>
	<hr />
		
	<div class="paginacion">
		<partial name="_Paginacion" model="Model" />
	</div>
</div>
