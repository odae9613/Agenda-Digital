@using ImOdNotes.Models.ViewModels;
@model PaginadoViewModel<ImOdNotes.Core.Entities.Nota>
@* @model IEnumerable<ImOdNotes.Core.Entities.Nota> *@

@{
	ViewData["Title"] = "Index";
}
@section MenuPagina {
	@{
		await Html.RenderPartialAsync("_MenuAsideNotas");
	}
}
<div id="pagina">
	<div id="principal">
		<h3>Notas</h3>
		<div class="notas">
			@foreach (var item in Model.Lista)
			{
				<div class="cardNotas">
					<a asp-area="" asp-controller="Nota" asp-action="Details"
						   asp-route-id="@item.Id"
						   type="button">
						<span class="tituloCard">
							<h5 class="tituloNota">
								@Html.DisplayFor(modelItem => item.Titulo)
							</h5>
							<i class="bi bi-journal-richtext"></i>
						</span>
					</a>
					<hr />
					<p>
						@Html.DisplayFor(modelItem => item.Contenido)
					</p>
					<hr />
					<div class="acciones">
						<a asp-action="Details" asp-route-id="@item.Id"
							   type="button"
							   class="btn btn-outline-primary btn-sm">
							<i class="bi-journal-text"></i>
						</a>
						<a asp-action="Edit" asp-route-id="@item.Id"
							   type="button"
							   class="btn btn-outline-primary btn-sm">
							<i class="bi-pencil"></i>
						</a>
						<a asp-action="Favorito"
							   asp-route-id="@item.Id"
							@* asp-route-page="@ViewBag.PaginaActual" *@
							   asp-route-page="@Model.PaginaActual"
							   type="button" class="btn btn-outline-primary btn-sm">
							<i class="bi @((item.Favorito) ? "bi bi-star-fill" : "bi-star")"></i>
						</a>
						<a asp-action="Delete"
							   asp-route-id="@item.Id"
							   type="button"
							   class="btn btn-outline-secondary btn-sm">
							<i class="bi-trash"></i>
						</a>
					</div>
				</div>
			}
		</div>
		<hr />
		
		<div class="paginacion">
			<partial name="_Paginacion" model="Model" />
		</div>
	</div>
</div>