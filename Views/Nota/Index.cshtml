@model IEnumerable<ImOdNotes.Core.Entities.Nota>

@{
    ViewData["Title"] = "Index";
}
@section MenuPagina {
    @{
        await Html.RenderPartialAsync("_MenuAsideNotas");
    }
}
<div id="pagina">
    <div id="principal">
    <h3>Notas</h3>
    <div class="notas">
        @foreach (var item in Model)
        {
            <div class="cardNotas">
                <a asp-area="" asp-controller="Nota" asp-action="Details"
                       asp-route-id="@item.Id"
                       type="button">
                    <span class="tituloCard">
                        <h5 class="tituloNota">
                            @Html.DisplayFor(modelItem => item.Titulo)
                        </h5>
                        <i class="bi bi-journal-richtext"></i>
                    </span>
                </a>
                <hr />
                <p>
                    @Html.DisplayFor(modelItem => item.Contenido)
                </p>
                <hr />
                <div class="acciones">
                    <a asp-action="Details" asp-route-id="@item.Id"
                           type="button"
                           class="btn btn-outline-primary btn-sm">
                        <i class="bi-journal-text"></i>
                    </a>
                    <a asp-action="Edit" asp-route-id="@item.Id"
                           type="button"
                           class="btn btn-outline-primary btn-sm">
                        <i class="bi-pencil"></i>
                    </a>
                    <a asp-action="Favorito"
                           asp-route-id="@item.Id"
                           asp-route-page="@ViewBag.PaginaActual"
                           type="button" class="btn btn-outline-primary btn-sm">
                        <i class="bi @((item.Favorito) ? "bi bi-star-fill" : "bi-star")"></i>
                    </a>
                    <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           type="button"
                           class="btn btn-outline-secondary btn-sm">
                        <i class="bi-trash"></i>
                    </a>
                </div>
            </div>
        }
    </div>
    
    <div class="d-flex justify-content-between align-items-center">
        <ul class="pagination mb-0">
            <li class="page-item @(ViewBag.PaginaActual == 1 ? "disabled" : "")">
                <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.PaginaActual - 1)">
                    Anterior
                </a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
            {
                <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                    <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i">
                        @i
                    </a>
                </li>
            }
            <li class="page-item @(ViewBag.PaginaActualFav == ViewBag.TotalPaginas ? "disabled" : "")">
                <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.PaginaActual + 1)">
                    Siguiente
                </a>
            </li>
        </ul>
    </div>
    </div>
</div>