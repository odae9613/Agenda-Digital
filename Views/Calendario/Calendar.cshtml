@{
	ViewData["Titulo"] = "Calendario";
}

<div id="pagina">
	@section MenuPagina {
		@{
			await Html.RenderPartialAsync("_MenuAsideHome");
		}
	}

	<div id="calendar"></div>
	@* Modal *@
	<div class="modal fade" id="modalCalendario" tabindex="-1">
		<div class="modal-dialog">
			<div class="modal-content">

				<div class="modal-header">
					<h5 class="modal-title">Detalle del evento</h5>
					<button type="button"
							class="btn-close"
							data-bs-dismiss="modal">
					</button>
				</div>

				<div class="modal-body" id="modalBody">
				</div>

			</div>
		</div>
	</div>
	@section Scripts {
		<script>
				document.addEventListener('DOMContentLoaded', function () {

				var calendarEl = document.getElementById('calendar');

				var calendar = new FullCalendar.Calendar(calendarEl, {

					initialView: 'dayGridMonth',
					locale: 'es-ES',
					firstDay: 1,
					
					events: '/Calendario/GetTareasEventos',

					eventClick: function (info) {

						const tipo = info.event.extendedProps?.tipo;

						if (tipo === "Evento") {
							abrirModalEvento(info.event.id);
						} else if (tipo === "Tarea") {
							abrirModalTarea(info.event.id);
						}
					}
					});

					calendar.render();
				});
		</script>
	}
</div>