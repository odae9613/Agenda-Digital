<div class="accionesOpciones">

	<a class="btn btnOpciones"
		   asp-controller="Tarea"
		   asp-action="Index">

		<i i class="bi bi-check2-square"></i>
		Tareas
	</a>

	<a class="btn btnOpciones"
		   asp-controller="Tarea"
		   asp-action="Create">

		<i class="bi bi-plus-circle"></i>
		Crea tareas
	</a>

	<a class="btn btnFavoritos"
		   asp-controller="Tarea"
		   asp-action="ListaFavoritos">

		<i class="bi bi-star-fill"></i>
		Favoritos
	</a>

	<a class="btn btnOpciones"
		   asp-controller="CategoriaTarea"
		   asp-action="Index">

		<i class="bi bi-tags"></i>
		Categorías
	</a>

	<a class="btn btnCategoria"
		   asp-controller="CategoriaTarea"
		   asp-action="Create">

		<i class="bi bi-plus-circle-dotted"></i>
		Categoría
	</a>

</div>


