<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ImOdNotes</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	@* <link rel="stylesheet" href="~/css/usuarioLogin.css" asp-append-version="true" /> *@
	@* A    R   C   H   I   V   O   S       CSS *@
	<link rel="stylesheet" href="~/css/Calendario.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/constantes.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/menuLateral.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/menuOpciones.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gasto.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/usuarioLogin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/inicio.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pagina.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ImOdNotes.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/enums.css" asp-append-version="true" />
    @*  I   C   O   N   O    *@
    <link rel="icon" type="image/x-icon" href="~/iMod_Notes.ico" />
    @*  F   U   L   L       C   A   L   E   N   D   A   R *@
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
    @*  I   C   O   N   O   S    *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    
</head>
<body>
    <header>
        <img src="~/img/iMod_Notes.png"/> 
        <div class="usuarioPanel">

            @if (User.Identity!.IsAuthenticated)
            {
                <div class="user-info">

                    <i class="bi bi-person-circle user-icon"></i>

                    <span class="user-name">
                        @User.Identity.Name
                    </span>

                    <form asp-controller="Usuario" asp-action="Logout" method="post" class="logout-form">
                        <button type="submit" class="logout-btn">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>

                </div>
            }

        </div>
    </header>
    <div class="Layout">
        <aside>
            @await RenderSectionAsync("MenuPagina", required: false)

        </aside>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @*  A   R   C   H   I   V   O   S       J   S *@
    <script src="~/js/Constantes.js"></script>
    <script src="~/js/completada.js"></script>
    <script src="~/js/favorito.js" asp-append-version="true"></script>
</body>
</html>
