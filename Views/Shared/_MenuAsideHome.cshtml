@*  M   E   N   Ú       L   A   T   E   R   A   L       H   O   M   E   *@
<ul class="mimenu">
	<li class="liespecial">
		Funciones
	</li>
	<li class="nav-item">
		<a asp-area="" asp-controller="Home" asp-action="Inicio">
			<span>Inicio</span>
			<i class="bi bi-house"></i>
		</a>
	</li>
	<li class="nav-item">
		<a asp-area="" asp-controller="Calendario" asp-action="Calendar">
			<span>Calendario</span>
			<i class="bi bi-calendar3"></i>
		</a>
	</li>
	<li class="nav-item">
		<a asp-area="" asp-controller="Evento" asp-action="Index">
			<span>Eventos</span>
			<i class="bi bi-calendar-event"></i>
		</a>
	</li>
	<li class="nav-item">
		<a asp-area="" asp-controller="Nota" asp-action="Index">
			<span>Notas</span>
			<i class="bi bi-stickies"></i>
		</a>
	</li>
	<li class="nav-item">
		<a asp-area="" asp-controller="Tarea" asp-action="Index">
			<span>Tareas</span>
			<i class="bi bi-check2-square"></i>
		</a>
	</li>
	<li class="nav-item">
		<a asp-area="" asp-controller="Gasto" asp-action="Index">
			<span>Gastos</span>
			<i class="bi bi-cash-coin"></i>
		</a>
	</li>
	<li class="nav-item">
		<a asp-area="" asp-controller="Home" asp-action="Privacy">
			<span>Manual de usuario</span>
			<i class="bi bi-book"></i>
		</a>
	</li>
	@if(User.IsInRole("Administrador"))
	{
		<li class="liespecial">
			Administrador
		</li>
		<li class="nav-item">
			<a asp-area="" asp-controller="Usuario" asp-action="Index">
				<span>Usuarios</span>
				<i class="bi bi-people"></i>
			</a>
		</li>
		<li class="nav-item">
			<a asp-area="" asp-controller="Rol" asp-action="Index">
				<span>Roles</span>
				<i class="bi bi-shield-lock"></i>
			</a>
		</li>
	}
