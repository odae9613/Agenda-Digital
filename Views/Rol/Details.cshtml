@model ImOdNotes.Core.Entities.Rol

@{
    ViewData["Title"] = "Details";
}
@section MenuPagina {
	@{
		await Html.RenderPartialAsync("_MenuAsideRoles");
	}
}

<div id="pagina">
    <div id="principal">
        <h3>Detalles del rol: @Html.DisplayFor(model => model.Nombre)</h3>
        <div>
            <hr />
            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Nombre)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Nombre)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Descripcion)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Descripcion)
                </dd>
            </dl>
        </div>
        <div id="finalFormulario">
            <a asp-action="Index">Regresar a la Lista</a>
            <a asp-action="Edit" asp-route-id="@Model?.Id">Editar rol: @Html.DisplayFor(model => model.Nombre)</a>
        </div>
    </div>
</div>