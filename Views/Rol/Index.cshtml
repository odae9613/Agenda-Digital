@using ImOdNotes.Models.ViewModels;
@model PaginadoViewModel<ImOdNotes.Core.Entities.Rol>

@{
    ViewData["Title"] = "Index";
}
@section MenuPagina {
    @{
        await Html.RenderPartialAsync("_MenuAsideHome");
    }
}

<div id="pagina">
    <div id="principal">
        <div class="opcionesHeader">

            <div class="tituloOpciones">
                <h2>
                    <i class="bi bi-shield-lock"></i>
                    Roles
                </h2>
            </div>
            <partial name="_MenuAsideRoles" />

        </div>
        <hr />
        <div id="tablaIndex">
            <table class="table col-12">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Lista.FirstOrDefault().Nombre)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Lista.FirstOrDefault().Descripcion)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Lista)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Nombre)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Descripcion)
                            </td>
                            <td>
                                <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       type="button"
                                       class="btn btn-outline-primary btn-sm">
                                    <i class="bi-journal-text"></i>
                                </a>
                                <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       type="button"
                                       class="btn btn-outline-primary btn-sm">
                                    <i class="bi-pencil"></i>
                                </a>
                                <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       type="button"
                                       class="btn btn-outline-secondary btn-sm">
                                    <i class="bi-trash text-danger"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @* P    A   G   I   N   A   C   I   O   N *@
            <div class="paginacion">
                <partial name="_Paginacion" model="Model" />
            </div>

        </div>
    </div>
</div>