@model ImOdNotes.Core.Entities.CategoriaTarea

@{
    ViewData["Title"] = "Details";
}

@section MenuPagina {
	@{
		await Html.RenderPartialAsync("_MenuAsideHome");
	}
}
<div id="pagina">
    <div id="principal">
        <div class="opcionesHeader">

            <div class="tituloOpciones">
                <h2>
                    <i class="bi bi-check2-square"></i>
                    Detalles de categoría
                </h2>
            </div>
            <partial name="_MenuAsideTareas" />

        </div>
        <h3>Detalles de la categoría de tareas</h3>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Nombre)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Nombre)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Descripcion)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Descripcion)
            </dd>
        </dl>
        <div id="finalFormulario">
            <a asp-action="Index">Regresar a la Lista</a>
            <a asp-action="Edit" asp-route-id="@Model?.Id">Editar</a>
        </div>
    </div>
</div>