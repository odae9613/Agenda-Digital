@model ImOdNotes.Core.Entities.CategoriaEvento

@{
	ViewData["Title"] = "Delete";
}

<div id="pagina">
	@section MenuPagina {
		@{
			await Html.RenderPartialAsync("_MenuAsideHome");
		}
	}
	<div id="principal">
		<div class="opcionesHeader">

			<div class="tituloOpciones">
				<h2>
					<i class="bi bi-calendar-event"></i>
					Eliminar categoría de eventos
				</h2>
			</div>
			<partial name="_MenuAsideEventos" />

		</div>
		<hr />
		<dl class="row">
			<dt class="col-sm-2">
				@Html.DisplayNameFor(model => model.Nombre)
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.Nombre)
			</dd>
			<dt class="col-sm-2">
				@Html.DisplayNameFor(model => model.Descripcion)
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.Descripcion)
			</dd>
			<form asp-action="Delete">
				<input type="hidden" asp-for="Id" />
				<div id="finalFormulario">
					<a asp-action="Index">Regresar a la Lista de catregorias de eventos</a>
					<input type="submit" value="Eliminar categoría" class="btn btn-danger" />
				</div>
			</form>
		</dl>
	</div>
</div>