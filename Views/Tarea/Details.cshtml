@model ImOdNotes.Core.Entities.Tarea

@{
	ViewData["Title"] = "Details";
}
@section MenuPagina {
	@{
		await Html.RenderPartialAsync("_MenuAsideTareas");
	}
}

<div id="pagina">
	<div id="principal">
		<h3>Tarea: @Html.DisplayFor(model => model.Titulo)</h3>
		<hr />
		<dl class="row">
			<dt class="col-sm-3">
				@Html.DisplayNameFor(model => model.Titulo)
			</dt>
			<dd class="col-sm-9">
				@Html.DisplayFor(model => model.Titulo)
			</dd>
			<dt class="col-sm-3">
				@Html.DisplayNameFor(model => model.Completado)
			</dt>
			<dd class="col-sm-9">
				@Html.DisplayFor(model => model.Completado)
			</dd>
			<dt class="col-sm-3">
				@Html.DisplayNameFor(model => model.Prioridad)
			</dt>
			<dd class="col-sm-9">
				@Html.DisplayFor(model => model.Prioridad)
			</dd>
			<dt class="col-sm-3">
				@Html.DisplayNameFor(model => model.Favorito)
			</dt>
			<dd class="col-sm-9">
				@Html.DisplayFor(model => model.Favorito)
			</dd>
			<dt class="col-sm-3">
				Vence
			</dt>
			<dd class="col-sm-9">
				@Model.FechaVencimiento?.ToString("dd/MM/yyyy")
			</dd>
			<dt class="col-sm-3">
				Fecha Creacion
			</dt>
			<dd class="col-sm-9">
				@Model.FechaCreacion.ToString("dd/MM/yyyy")
			</dd>
			<dt class="col-sm-3">
				Ultima actualización
			</dt>
			<dd class="col-sm-9">
				@Model.FechaActualizacion.ToString("dd/MM/yyyy")
			</dd>
			<dt class="col-sm-3">
				Categoría
			</dt>
			<dd class="col-sm-9">
				@Html.DisplayFor(model => model.CategoriaTarea.Nombre)
			</dd>
			<dt class="col-sm-3">
				@Html.DisplayNameFor(model => model.Descripcion)
			</dt>
			<dd class="col-sm-9">
				@Html.DisplayFor(model => model.Descripcion)
			</dd>
		</dl>
	</div>
	<div>
		<a asp-action="Index">Regresar a la lista de eventos</a>
		<a asp-action="Edit" asp-route-id="@Model?.Id">Editar</a>
	</div>

</div>