@model IEnumerable<ImOdNotes.Core.Entities.Tarea>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

@section MenuPagina {
    @{
        await Html.RenderPartialAsync("_MenuAsideTareas");
    }
}
    <div id="pagina">
        <h3>Tareas favoritas</h3>
        <div id="tablaIndex">
    
            <table class="table">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Titulo)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Completado)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Descripcion)
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Titulo)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Completado)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Descripcion)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <!-- ANTERIOR -->
            <ul class="pagination mb-0">
                <li class="page-item @(ViewBag.PaginaActual == 1 ? "disabled" : "")">
                    <a class="page-link"
                           asp-action="ListaFavoritos"
                           asp-route-page="@(ViewBag.PaginaActual - 1)">
                        Anterior
                    </a>
                </li>

                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {
                    <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                        <a class="page-link"
                               asp-action="ListaFavoritos"
                               asp-route-page="@i">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(ViewBag.PaginaActual == ViewBag.TotalPaginas ? "disabled" : "")">
                    <a class="page-link"
                           asp-action="ListaFavoritos"
                           asp-route-page="@(ViewBag.PaginaActual + 1)">
                        Siguiente
                    </a>
                </li>
            </ul>
        </div>
</div>
