@using ImOdNotes.Models.ViewModels
@model PaginadoViewModel<ImOdNotes.Core.Entities.Tarea>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

@section MenuPagina {
    @{
        await Html.RenderPartialAsync("_MenuAsideHome");
    }
}
<div id="pagina">
    <div class="opcionesHeader">

        <div class="tituloOpciones">
            <h2>
                <i class="bi bi-check2-square"></i>
                Tareas
            </h2>
        </div>
        <partial name="_MenuAsideTareas" />

    </div>
        <h3>Tareas favoritas</h3>
        <div id="tablaIndex">
    
            <table class="table">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Lista.FirstOrDefault().Titulo)
                        </th>
                        <th>
                        @Html.DisplayNameFor(model => model.Lista.FirstOrDefault().Completado)
                        </th>
                        <th>
                        @Html.DisplayNameFor(model => model.Lista.FirstOrDefault().Descripcion)
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Lista)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Titulo)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Completado)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Descripcion)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            
        @* P    A   G   I   N   A   C   I   O   N *@
        <div class="paginacion">
            <partial name="_Paginacion" model="Model" />
        </div>
        </div>
</div>
