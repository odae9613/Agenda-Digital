@using ImOdNotes.Models.ViewModels
@model PaginadoViewModel<ImOdNotes.Core.Entities.Tarea>
@* @model IEnumerable<ImOdNotes.Core.Entities.Tarea> *@

@{
	ViewData["Title"] = "Index";
}
@section MenuPagina {
	@{
		await Html.RenderPartialAsync("_MenuAsideTareas");
	}
}

<div id="pagina">
	<div id="principal">
		<h3>Tareas</h3>
		<div id="tablaIndex">
            
			<table class="table">
				<thead>
					<tr>
						@* <th>
							@Html.DisplayNameFor(model => model.Completado)
						</th> *@
						<th></th>
						<th>
							@Html.DisplayNameFor(model => model.Lista.First().Titulo)
						</th>
						<th>
							@Html.DisplayNameFor(model => model.Lista.First().Descripcion)
						</th>
						<th>
							@Html.DisplayNameFor(model => model.Lista.First().Prioridad)
						</th>
						<th>
							Vencimiento
						</th>
						<th>
							Categoría
						</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					@foreach (var tarea in Model.Lista)
					{
						<tr>
							<td>
								
								<input type="checkbox" class="form-check-input tarea-check"
									   data-id="@tarea.Id" @(tarea.Completado ? "checked" : "") />

							</td>
							<td>
								@Html.DisplayFor(modelItem => tarea.Titulo)
							</td>
							<td>
								@Html.DisplayFor(modelItem => tarea.Descripcion)
							</td>
							<td>
								@Html.DisplayFor(modelItem => tarea.Prioridad)
							</td>
							<td>
								@tarea.FechaVencimiento?.ToString("dd/MM/yyyy")
							</td>
							<td>
								@Html.DisplayFor(modelItem => tarea.CategoriaTarea.Nombre)
							</td>
							<td>
								<a asp-action="Details"
									   asp-route-id="@tarea.Id"
									type="button"
									class="btn btn-outline-primary btn-sm">
									<i class="bi-journal-text"></i>
								</a>
								<a asp-action="Edit" 
									   asp-route-id="@tarea.Id"
									   type="button"
									   class="btn btn-outline-primary btn-sm">
									<i class="bi-pencil"></i>
								</a>
								<a asp-action="Favorito"
									   asp-route-id="@tarea.Id"
									   asp-route-page="@ViewBag.PaginaActual"
									   type="button" class="btn btn-outline-primary btn-sm">
									<i class="bi @((tarea.Favorito) ? "bi bi-star-fill text-primary" : "bi-star text-muted")"></i>
								</a>
								<a asp-action="Delete" asp-route-id="@tarea.Id"
									   type="button"
									   class="btn btn-outline-secondary btn-sm">
									<i class="bi-trash text-danger"></i>
								</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<hr />
		<div class="paginacion">
			<partial name="_Paginacion" model="Model" />
		</div>
	</div>
</div>