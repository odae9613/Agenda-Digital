@using ImOdNotes.Core.Entities
@section MenuPagina {
	@{
		await Html.RenderPartialAsync("_MenuAsideHome");
	}
}
@{
	List<Evento> eventosMes = ViewBag.eventoMes;
	List<Evento> eventosSemana = ViewBag.eventoSemana;
	List<Tarea> tareaMes = ViewBag.tareaMes;
	List<Tarea> tareaSemana = ViewBag.tareaSemana;
	List<Evento> listaEventos = ViewBag.listaEventos;
	List<Tarea> tareas = ViewBag.tareaMes;
	List<Tarea> tareasSemana = ViewBag.tareasSemana;
	List<Tarea> listaTareas = ViewBag.listaTareas;
}
<div id="paginaInicio">
	@Html.AntiForgeryToken()
	<section>
		<div>Bienvenido, @ViewBag.usuario. </div>
		<div class="bienvenida">
			<a>
				Pendientes de hoy
			</a>
			<p>@ViewBag.hoy.ToString("dddd, dd 'de' MMMM ' ' yyyy")</p>
			@if (ViewBag.eventosHoy == 1)
			{
				<a>@ViewBag.eventosHoy evento, </a>
			}
			@if (@ViewBag.eventosHoy > 1)
			{
				<a>@ViewBag.eventosHoy eventos, </a>
			}
			@if (@ViewBag.tareasHoy == 1)
			{
				<a>@ViewBag.tareasHoy tarea</a>
			}
			@if (@ViewBag.tareasHoy > 1)
			{
				<a>@ViewBag.tareasHoy tareas</a>
			}
			<div class="container-fluid">
				<div class="row">
					<div class="col-12 col-md-6">
						@if (listaEventos != null && listaEventos.Any())
						{
							<div>
								<h6>Eventos</h6>
								@foreach (var evento in listaEventos)
								{
									<i>@evento.Titulo</i>
								}
							</div>
						}
					</div>
					<div class="col-12 col-md-6">
						<div>
							@if (listaTareas != null && listaTareas.Any())
							{
								<div>
									<h6>Tareas</h6>
									@foreach (var tarea in listaTareas)
									{
										<i>@tarea.Titulo</i>
									}
								</div>
							}
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="frameCard">
			<a class="card" asp-area="" asp-controller="Nota" asp-action="Index">
				<span class="tituloCard">
					<h5>Notas</h5>
					<i class="bi bi-journal-richtext"></i>
				</span>
				<hr />
				<h3>@ViewBag.totalNotas</h3>
			</a>
			<a class="card" asp-area="" asp-controller="Gasto" asp-action="Index">
				<span class="tituloCard">
					<h5>Gastos</h5>
					<i class="bi bi-bank"></i>
				</span>
				<hr />
				<h3>@ViewBag.totalGastos</h3>
			</a>
			<a class="card" asp-area="" asp-controller="Evento" asp-action="Index">
				<span class="tituloCard">
					<h5>Eventos</h5>
					<i class="bi bi-calendar"></i>
				</span>
				<hr />
				<h3>@ViewBag.totalEventos</h3>
			</a>
			<a class="card" asp-area="" asp-controller="Tarea" asp-action="Index">
				<span class="tituloCard">
					<h5>Tareas</h5>
					<i class="bi bi-list-check"></i>
				</span>
				<hr />
				<h3>@ViewBag.totalTareas</h3>
			</a>
		</div>
		<hr />
		<div class="bienvenida">
			@if ((eventosSemana != null && eventosSemana.Any()) ||
			(tareasSemana != null && tareasSemana.Any()))
			{
				<a>
					Pendientes de @ViewBag.hoy.ToString("MMMM ':'")
				</a>
				<hr />
				@if (eventosMes != null && eventosMes.Any())
				{
					<p>Eventos</p>
					<table>
						<thead>
							<tr>
								<th>Titulo</th>
								<th>Fecha</th>
								<th>Ubicación</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var evento in eventosMes)
							{
								<tr>
									<td>@evento.Titulo</td>
									<td>@evento.FechaInicio.ToString("dd/MM/yy")</td>
									<td>@evento.Ubicacion</td>
								</tr>
							}
						</tbody>
					</table>
				}
				@if (tareaMes != null && tareaMes.Any())
				{
					<hr/>
					<p>Tareas</p>
					<table>
						<thead>
							<tr>
								<th></th>
								<th>Título</th>
								<th>Vence</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var tarea in tareas)
							{
								<tr>
									<td>
										<input type="checkbox" class="form-check-input tarea-check"
											   data-id="@tarea.Id" @(tarea.Completado ? "checked" : "") />
									</td>
									<td>@tarea.Titulo</td>
									<td>@tarea.FechaVencimiento?.ToString("dd/MM/yy")</td>
								</tr>
							}
						</tbody>
					</table>
				}
			}
			else
			{
				<h3>Sin pendientes en @ViewBag.hoy.ToString("MMMM")</h3>
			}
		</div>
	</section>

	@*	S	E	M	A	N	A	 *@
	<aside>
		<div class="notificaciones">
			@if ((eventosSemana != null && eventosSemana.Any()) ||
				   (tareasSemana != null && tareasSemana.Any()))
			{

				<h5 class="mb-3">Notificaciones pendientes</h5>
				@if (eventosSemana != null && eventosSemana.Any())
				{
					<div class="notificacion">
						<h6>Eventos</h6>
						<table class="tabla-mini">
							<thead>
								<tr>
									<th></th>
									<th></th>
								</tr>
							</thead>
							<tbody>
								@foreach (var evento in eventosSemana)
								{
									<tr>
										<td>@evento.Titulo</td>
										<td>@evento.FechaInicio.ToString("ddd dd/MM/yy")</td>
									</tr>
								}
							</tbody>
                        
						</table>
					</div>
				}
				@if (tareasSemana != null && tareasSemana.Any())
				{
					<div class="notificacion">
						<h6>Tareas</h6>
						<table class="tabla-mini">
							<thead>
								<tr>
									<th></th>
									<th>Título</th>
									<th>Vence</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var tarea in tareasSemana)
								{
									<tr>
										<td>
											<input type="checkbox" class="form-check-input tarea-check"
												   data-id="@tarea.Id" @(tarea.Completado ? "checked" : "") />
										</td>
										<td>@tarea.Titulo</td>
										<td>@tarea.FechaVencimiento?.ToString("ddd dd/MM/yy")</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			}
			else
			{
				<div class="notificacion">
					<h6>Sin notificaciones</h6>
				</div>
			}
		</div>
		<div class="mes">
			<h6>Calendario</h6>
			@*  I   N   I   C   I   O *@


			@*  F   I   N    *@
		</div>
	</aside>
</div>