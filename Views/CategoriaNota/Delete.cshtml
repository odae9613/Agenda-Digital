@model ImOdNotes.Core.Entities.CategoriaNota

@{
	ViewData["Title"] = "Delete";
}

@section MenuPagina {
	@{
		await Html.RenderPartialAsync("_MenuAsideHome");
	}
}
<div id="pagina">
	<div id="principal">
		<div class="opcionesHeader">

			<div class="tituloOpciones">
				<h2>
					<i class="bi bi-stickies"></i>
					Eliminar categoría
				</h2>
			</div>
			<partial name="_MenuAsideNotas" />

		</div>
		<h3>Eliminar la categoría de nota</h3>
		<hr />
		<dl class="row">
			<dt class="col-sm-3">
				@Html.DisplayNameFor(model => model.Nombre)
			</dt>
			<dd class="col-sm-9">
				@Html.DisplayFor(model => model.Nombre)
			</dd>
			<dt class="col-sm-3">
				@Html.DisplayNameFor(model => model.Descripcion)
			</dt>
			<dd class="col-sm-9">
				@Html.DisplayFor(model => model.Descripcion)
			</dd>
		</dl>
		<form asp-action="Delete">
			<input type="hidden" asp-for="Id" />
			<div id="finalFormulario">
				<a asp-action="Index">Regresar a la Lista</a>
				<input type="submit" value="Eliminar" class="btn btn-danger" />
			</div>
		</form>
	</div>
</div>