@model ImOdNotes.Models.ViewModels.RegistroViewModel

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/registroLogin.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/constantes.css" asp-append-version="true" />
@*  I   C   O   N   O    *@
<link rel="icon" type="image/x-icon" href="~/LilaBloomNotas.ico" />

@{
	Layout = null;
}

@{
	ViewData["Title"] = "Registrar cuenta";
}

<div class="pagina">

	<div class="left">
		<div class="logoContainer">
			<img src="~/img/LilaBloom-App.png" />
			<h1>LilaBloom Agenda</h1>
		</div>
	</div>
	<div class="right">
		<div class="usuarioLogin">
			<form asp-action="Registro" method="post" class="form-horizontal">
				@Html.AntiForgeryToken()
				<h1>Crear cuenta</h1>
				<p>Regístrtae en LilaBloom</p>
				<div class="form-group">
					<label asp-for="NombreUsuario" class="control-label">Nombre usuario</label>
					<input class="form-input" type="text" asp-for="NombreUsuario" placeholder="Usuario" required />
					<span asp-validation-for="NombreUsuario" class="text-danger"></span>
				</div>
				<div class="form-group">
					<label asp-for="Email" class="control-label">Email</label>
					<input class="form-input" type="email" asp-for="Email" placeholder="Email" required />
					<span asp-validation-for="Email" class="text-danger"></span>
				</div>
				<div class="form-group">
					<label asp-for="Password" class="control-label">Contraseña</label>
					<input class="form-input" asp-for="Password" type="password" placeholder="Contraseña" required />
					<span asp-validation-for="Password" class="text-danger"></span>
				</div>
				@* Solo si no hay usuarios en la base de datos *@
				<div class="form-group">
					<button type="submit" class="btn btn-primary">Registrar</button>
				</div>
				@if (ViewBag.ErrorMessage != null)
				{
					<div class="alert alert-danger mt-3">
						@ViewBag.ErrorMessage
					</div>
				}
				<div>
					¿Ya tienes cuenta? <a asp-action="Login">Inicia sesión aquí</a>
				</div>
			</form>
		</div>
	</div>
</div>


@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
