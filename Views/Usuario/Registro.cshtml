@model ImOdNotes.Models.ViewModels.RegistroViewModel

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

@{
	Layout = null;
}

@{
	ViewData["Title"] = "Registrar cuenta";
}

@* <h2>@ViewData["Title"]</h2> *@
<div class="paginaRegistro">

	<div class="left">
		<div class="logoContainer">
			<img src="~/img/iMod_Notes.png" />
			<h1>IMODNOTES</h1>
		</div>
	</div>
	<div class="right">
		<div class="usuarioLogin">
			<form asp-action="Registro" method="post" class="form-horizontal">
			@* <input type="hidden" asp-for="Id" /> *@
				<div class="form-group">
					<label asp-for="NombreUsuario" class="control-label">Nombre usuario</label>
					<input class="form-input" type="text" asp-for="NombreUsuario" placeholder="Usuario" required/>
				</div>
				<div class="form-group">
					<label asp-for="Email" class="control-label">Email</label>
					<input class="form-input" type="email" asp-for="Email" placeholder="Email" required/>
				</div>
				<div class="form-group">
					<label asp-for="Password" class="control-label">Contraseña</label>
					<input class="form-input" asp-for="Password" type="password" placeholder="Contraseña" required/>
				</div>
				@* Solo si no hay usuarios en la base de datos *@
				@* <input class="form-input" asp-for="RolId" type="text" placeholder="Rol" required/> *@
				<div class="form-group">
					<button type="submit" class="btn btn-primary">Registrar</button>
				</div>
				@if(ViewBag.ErrorMessage != null)
				{
					<div class="alert alert-danger mt-3">
						@ViewBag.ErrorMessage
					</div>
				}
				<div>
					¿Ya tienes cuenta? <a asp-action="Login">Inicia sesión aquí</a>
				</div>
			</form>
		</div>
	</div>
</div>


@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}

<style>
	html, body {
		width: 100%;
		height: 100%;
		margin: 0;
		padding: 0;
		font-family: 'DM Sans', sans-serif;
	}

	.paginaRegistro {
		display: flex;
		width: 100%;
		height: 100vh;
	}

	/* lado izquierdo */
	.left {
		flex: 1;
		background-color: #8FB9B3;
		display: flex;
		color: white;
		padding: 100px;
	}

	.logoContainer {
		width: 100%;
		border: solid black 2px;
		min-height: 50vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

		.logoContainer img {
			width: 100px;
			background-color: #ffffff;
		}

		.logoContainer h1 {
			color: #0A9EE0;
			font-family: 'Syne', sans-serif;
			font-size: 30px;
			font-weight: 700;
		}

	/* lado derecho */
	.right {
		flex: 1;
		background-color: #C59FBE;   
		/*#98B8B9*/
		display: flex;
		padding: 100px;
		justify-content: center;
		align-items: center;
	}

	/* formulario */
	.usuarioLogin {
		background-color: #98B8B9;
		width: 100%;
		border: solid black 2px;
		min-height: 50vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 50px;
		border-radius: 20px;
	}
	.usuarioLogin h1 {
		color: #ffffff;
	}
	.form-group{
		display: flex;
		flex-direction: column;
	}

	.form-group { margin-bottom: 20px; }
.form-group label { 
	display: block; font-size: 0.85rem; font-weight: 500; color: rgba(255,255,255,0.6); margin-bottom: 8px; letter-spacing: 0.5px; 
}

.form-input,
input[type="text"],
input[type="password"],
input[type="email"] {
	display: block;
  width: 100%;
  padding: 12px 16px;
  background-color: #1A3454;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8px;
  color: #FFFFFF;
  font-size: 0.95rem;
  transition: border-color 0.22s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.22s cubic-bezier(0.4, 0, 0.2, 1);
}
.form-input:focus {
  border-color: #0A9EE0;
  box-shadow: 0 0 0 3px rgba(10,158,224,0.15);
}
.form-input::placeholder { color: rgba(255,255,255,0.2); }


</style>