@model ImOdNotes.Core.Entities.Usuario

@{
    ViewData["Title"] = "Delete";
}
@section MenuPagina {
	@{
		await Html.RenderPartialAsync("_MenuAsideHome");
	}
}

<div id="pagina">
    <div id="principal">
        <div class="opcionesHeader">

            <div class="tituloOpciones">
                <h2>
                    <i class="bi bi-people"></i>
                    Eliminar Usuario
                </h2>
            </div>
            <partial name="_MenuAsideUsuarios" />

        </div>
        <h3>Eliminar usuario: @Html.DisplayFor(model => model.NombreUsuario)</h3>
        <hr />
        <h6>¿Estás seguro de eliminar este usuario?</h6>
        <div>
            <hr />
            <dl class="row">
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Nombre)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Nombre)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.NombreUsuario)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.NombreUsuario)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Apellido01)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Apellido01)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Apellido02)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Apellido02)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.FechaNacimiento)
                </dt>
                <dd class="col-sm-9">
                    @Model.FechaNacimiento.ToString("dd/MM/yyyy")
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.LugarNacimiento)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.LugarNacimiento)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Nacionalidad)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Nacionalidad)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Email)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Email)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Genero)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Genero)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.URLFotoPerfil)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.URLFotoPerfil)
                </dd>
            </dl>
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div id="finalFormulario">
                    <a asp-action="Index">Regresar a la Lista</a>
                    <input type="submit" value="Eliminar" class="btn btn-danger" />
                </div>
            </form>
        </div>

    </div>
</div>