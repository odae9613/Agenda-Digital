@using ImOdNotes.Models.ViewModels;
@model PaginadoViewModel<ImOdNotes.Core.Entities.Usuario>
@* @model IEnumerable<ImOdNotes.Core.Entities.Usuario> *@

@{
    ViewData["Title"] = "Index";
}
@section MenuPagina {
	@{
		await Html.RenderPartialAsync("_MenuAsideUsuarios");
	}
}

<div id="pagina">
    <div id="principal">
        <h3>Usuarios</h3>
        <div id="tablaIndex">
            
            <table class="table">
                <thead>
                    <tr>
                        <th>
                            Nombre
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Lista.First().NombreUsuario)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Lista.First().FechaNacimiento)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Lista.First().Email)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Lista.First().Genero)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Lista.First().Rol)
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Lista)
                    {
                        <tr>
                            <td>
                                    @($"{item.Nombre} {item.Apellido01} {item.Apellido02}")
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.NombreUsuario)
                            </td>
                            <td>
                                @item.FechaNacimiento.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Email)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Genero)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Rol.Nombre)
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id"
                                       type="button"
                                       class="btn btn-outline-primary btn-sm">
                                    <i class="bi-journal-text"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id"
                                       type="button"
                                       class="btn btn-outline-primary btn-sm">
                                    <i class="bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id"
                                       type="button"
                                       class="btn btn-outline-secondary btn-sm">
                                    <i class="bi-trash text-danger"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @*  P   A   G  I  N  A  C  I  O  N  *@
            <div class="paginacion">
                <partial name="_Paginacion" model="Model" />
            </div>
        </div>


    </div>
</div>