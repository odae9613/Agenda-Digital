@model ImOdNotes.Models.ViewModels.LoginViewModel

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

@{
	Layout = null;
}

@{
	ViewData["Title"] = "Iniciar sesión";
}

@* <h2>@ViewData["Title"]</h2> *@
<div class="paginaLogin">

	<div class="left">
		<div class="logoContainer">
			<img src="~/img/iMod_Notes.png" />
			<h1>IMODNOTES</h1>
		</div>
	</div>
	<div class="right">
		<div class="usuarioLogin">
			<form asp-action="Login" method="post" class="form-horizontal">
			@Html.AntiForgeryToken()
			<h1>Bienvenido de nuevo</h1>
			<p>Inicia sesión en tu cuenta IMODNOTES</p>
				<div class="form-group">
					<label asp-for="NombreUsuario" class="control-label">Usuario o Email</label>
					<input asp-for="NombreUsuario" class="form-control" />
					<span asp-validation-for="NombreUsuario" class="text-danger"></span>
				</div>
				<div class="form-group">
					<label asp-for="Password" class="control-label">Contraseña</label>
					<input asp-for="Password" class="form-control" type="password" />
					<span asp-validation-for="Password" class="text-danger"></span>
				</div>
				<div class="form-group">
					<div class="checkbox">
						<label>
							<input asp-for="RememberMe" /> Recordarme
						</label>
					</div>
				</div>
				<div class="form-group">
					<button type="submit" class="btn btn-primary">Iniciar sesión</button>
				</div>
				<div>
					¿No estás registrado? <a asp-action="Registro">Regístrate aquí</a>
				</div>
			</form>
		</div>
	</div>
</div>


@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}

<style>
	html, body {
		width: 100%;
		height: 100%;
		margin: 0;
		padding: 0;
		font-family: 'DM Sans', sans-serif;
	}

	.paginaLogin {
		display: flex;
		width: 100%;
		height: 100vh;
	}

	/* lado izquierdo */
	.left {
		flex: 1;
		background-color: #8FB9B3;
		display: flex;
		color: white;
		padding: 100px;
	}

	.logoContainer {
		width: 100%;
		border: solid black 2px;
		min-height: 50vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

		.logoContainer img {
			width: 100px;
			background-color: #ffffff;
		}

		.logoContainer h1 {
			color: #0A9EE0;
			font-family: 'Syne', sans-serif;
			font-size: 30px;
			font-weight: 700;
		}

	/* lado derecho */
	.right {
		flex: 1;
		background-color: #C59FBE;   
		/*#98B8B9*/
		display: flex;
		padding: 100px;
		justify-content: center;
		align-items: center;
	}

	/* formulario */
	.usuarioLogin {
		background-color: #98B8B9;
		width: 100%;
		border: solid black 2px;
		min-height: 50vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 50px;
		border-radius: 20px;
	}
	.usuarioLogin h1 {
		color: #ffffff;
	}
	.form-group{
		display: flex;
		flex-direction: column;
	}

	.form-group { margin-bottom: 20px; }
.form-group label { 
	display: block; font-size: 0.85rem; font-weight: 500; color: rgba(255,255,255,0.6); margin-bottom: 8px; letter-spacing: 0.5px; 
}

.form-input {
  width: 100%;
  padding: 12px 16px;
  background: #1A3454;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8px;
  color: #FFFFFF;
  font-size: 0.95rem;
  transition: border-color 0.22s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.22s cubic-bezier(0.4, 0, 0.2, 1);
}
.form-input:focus {
  border-color: #0A9EE0;
  box-shadow: 0 0 0 3px rgba(10,158,224,0.15);
}
.form-input::placeholder { color: rgba(255,255,255,0.2); }


</style>